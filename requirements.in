# Top-level Python dependencies for this repo.
# List only direct dependencies here; run `pip-compile` to generate the
# fully pinned, transitively-resolved requirements.txt.
#
# Example:
# fastapi

# data-read-write: ORM access to the SQLite database.
SQLAlchemy

# data-read-write: lower-boilerplate SQLite access, for comparison with
# the raw SQLAlchemy ORM version.
dataset

# data-read-write: MongoDB access, for comparison with the SQL versions.
pymongo

# data-scrape: HTTP client for calling REST APIs (PokeAPI) and fetching
# HTML pages to scrape.
requests

# data-scrape: transparent, drop-in HTTP response caching for requests.
requests-cache

# data-scrape: HTML parsing for the pokemondb.net scrape (no public API
# covers that data).
beautifulsoup4

# data-scrape: dedicated PokeAPI client library, for comparison with the
# raw `requests` version of the same calls.
pokebase

# data-scrape: unit tests for the HTML-parsing logic (see
# docs/python-implementation.md's testing conventions). First stage to
# need a test runner.
pytest

# data-scrape: the Scrapy framework itself (spider + item pipeline
# exercise), for comparison with the hand-rolled requests+BeautifulSoup
# version in pokemondb_scraper.py.
scrapy

# data-scrape: image decoding for scrapy.pipelines.images.ImagesPipeline,
# which the pokemon_scrapy project uses to download artwork.
# django: also required by Django's own ImageField (movie/models.py's
# Movie.image) - Django raises an error at migration time without it.
Pillow

# data-analysis: charting library for turning data-process's cleaned
# dataset into saved PNG charts.
matplotlib

# data-serve: the web framework the REST API is built on.
Flask

# data-serve: SQLAlchemy integration for the sqlite backend (Flask-scoped
# sessions, `db.Model` base class). flask-restless was also evaluated
# for this stage (see data-serve/README.md) and rejected - it's been
# unmaintained since 2015 and fails to even import under this repo's
# Flask/Werkzeug versions.
Flask-SQLAlchemy

# data-serve: CORS headers on the API, so d3-interactive-web (served
# from a different origin/port by http-server) is allowed to fetch it
# from the browser - see data-serve/README.md's "CORS" section.
Flask-Cors

# deploy: production WSGI server for data-serve. Flask's own app.run()
# (used for local dev, see app.py's __main__ block) is single-threaded
# and explicitly not meant for the public internet - see
# deploy/render.yaml, which runs `gunicorn app:app` instead.
gunicorn

# django: the framework itself, for django-impatient/moviereviews and
# the django-for-beginners/ per-chapter projects.
Django

# rest-apis-flask/library-crud: request validation and DB<->JSON
# serialization for the Author/Book CRUD API - see
# rest-apis-flask/README.md's "Persistence and serialization" section.
marshmallow

# rest-apis-flask/library-crud: Blueprint/MethodView routing that
# generates an OpenAPI spec from the same marshmallow schemas above, and
# serves it as an interactive Swagger UI - see rest-apis-flask/README.md's
# "API documentation" section.
flask-smorest

# rest-apis-flask/library-crud: this book's chapter on unit testing with
# nose - the original `nose` package is unmaintained and fails to even
# import on Python 3.10+ (relies on `collections.Callable`, removed in
# 3.10), so this stage uses nose2, its actively maintained successor,
# instead. See library-crud/README.md's "Testing" section for why this
# stage has two test files/runners instead of the repo's usual pytest
# alone.
nose2

# demos/labeling-fastapi-react and demos/long-jobs: the API framework
# for both FastAPI demos.
fastapi

# demos/labeling-fastapi-react and demos/long-jobs: ASGI server both
# FastAPI demos run under (plain, not the [standard] extra - neither
# demo needs its optional watchfiles/httptools/uvloop extras beyond
# what --reload already provides).
uvicorn

# demos/labeling-fastapi-react: mints and verifies the JWTs issued by
# api/security.py - see that module's docstring for the OAuth2-password
# + JWT pattern it follows from FastAPI's own docs.
pyjwt

# demos/labeling-fastapi-react: password hashing for api/security.py.
# FastAPI's current docs recommend pwdlib over passlib (stale, last
# released 2020) or fastapi-users (in maintenance mode) - see
# .claude/skills/web-stack-advisor/references/multi-user.md. The
# [argon2] extra pulls in the argon2-cffi backend, argon2's own current
# recommendation over bcrypt for new projects.
pwdlib[argon2]

# demos/long-jobs: the background task queue backing the
# "queued job, not a blocking request" demo - see
# demos/long-jobs/README.md's "Why Huey on SQLite" section.
huey

# demos/labeling-fastapi-react and demos/long-jobs: FastAPI's
# TestClient (used by both demos' pytest suites) is built on httpx, not
# requests - it's a required test-time dependency, not bundled with
# fastapi/starlette themselves.
httpx

# demos/labeling-fastapi-react: OAuth2PasswordRequestForm (api/main.py's
# POST /auth/login) parses a multipart/form-encoded body, which FastAPI
# only supports with python-multipart installed - not bundled with
# fastapi itself.
python-multipart
