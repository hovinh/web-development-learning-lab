# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# Node
node_modules/

# Generated output (reproducible by running the stage's script)
dataviz-python-js/data-read-write/pokemon.json
dataviz-python-js/data-read-write/pokedex.db
dataviz-python-js/data-read-write/pokedex_dataset.db
dataviz-python-js/data-read-write/gen_1_legendaries.csv
dataviz-python-js/data-read-write/gen_1_legendaries.json

# data-scrape: HTTP/API response caches and downloaded artwork - all
# reproducible by running main.py again.
dataviz-python-js/data-scrape/http_cache.sqlite
dataviz-python-js/data-scrape/pokemondb_cache.sqlite
dataviz-python-js/data-scrape/pokebase_cache/
dataviz-python-js/data-scrape/images/

# data-scrape/pokemon_scrapy: Scrapy's own HTTP cache, downloaded
# artwork, and this project's documented default feed export filename -
# all reproducible by running `scrapy crawl pokemondb` again.
dataviz-python-js/data-scrape/pokemon_scrapy/.scrapy/
dataviz-python-js/data-scrape/pokemon_scrapy/images/
dataviz-python-js/data-scrape/pokemon_scrapy/pokemon_scrapy_output.json

# data-scrape: the full compiled dataset - reproducible by running
# compile_pokedex.py again (which saves artwork into the same
# data-scrape/images/ ignored above, and its own progress log).
dataviz-python-js/data-scrape/pokedex.csv
dataviz-python-js/data-scrape/compile_pokedex.log

# data-process: pokedex.json + images/ are committed on purpose, not
# ignored - unlike this repo's other generated output, they're the
# input data-serve (and therefore d3-interactive-web) needs to run at
# all, and reproducing them from scratch means re-running data-scrape's
# live PokeAPI/pokemondb.net scrape, which is slow and depends on
# those sites being reachable and unchanged. Committing this stage's
# output means a fresh clone can run data-serve and d3-interactive-web
# immediately with no scrape step. See data-process/README.md's
# "Files" section.

# data-analysis: charts - reproducible by running main.py again against
# data-process/pokedex.json.
dataviz-python-js/data-analysis/charts/

# data-serve: the sqlite backend's database - reproducible by running
# load_sqlite.py again against data-process's output.
dataviz-python-js/data-serve/pokedex.db

# django-impatient: the moviereviews project's local dev database and
# uploaded media - reproducible by running `manage.py migrate` again;
# media files are whatever's been uploaded through the running dev
# site, not tracked content. See django-impatient/README.md.
django-impatient/moviereviews/db.sqlite3
django-impatient/moviereviews/media/

# django-for-beginners: each chapter's own local dev database -
# reproducible by running that chapter's `manage.py migrate` (and, if
# it has one, `manage.py seed_*`) again. Matches every per-chapter
# project folder under django-for-beginners/, not just the current
# ones, since a new sibling project is added each chapter.
django-for-beginners/*/db.sqlite3

# django-impatient: collectstatic's output (see moviereviews/settings.py's
# STATIC_ROOT) - only ever needed on a real deployment (DEBUG=False),
# reproducible there with `manage.py collectstatic`. Never populated
# during local dev, since the dev server serves static files itself
# without this when DEBUG=True.
django-impatient/moviereviews/staticfiles/

# pytest's own cache, generated wherever tests are run from
.pytest_cache/

# library-crud: the SQLite database - reproducible by running app.py
# again (create_app() calls db.create_all() on startup).
rest-apis-flask/library-crud/library.db

# demos: every demo's local dev database - reproducible by running that
# demo's migrate/seed steps again (see each demo's README.md).
demos/labeling-django/db.sqlite3
demos/labeling-fastapi-react/api/labeling.db
demos/long-jobs/jobs.sqlite3

# demos/long-jobs: Huey's own SQLite-backed task queue storage -
# reproducible; nothing in it is meant to persist across runs. See
# demos/long-jobs/README.md's "Why Huey on SQLite" section.
demos/long-jobs/huey.sqlite3

# demos/labeling-fastapi-react/web: node_modules/dist are already
# covered by that project's own scaffolded .gitignore (same precedent
# as angular-typescripts-beginner/my-app/.gitignore) - nothing extra
# needed here.

# demos/psa-terminal-map: no entry needed. It's a static page with no
# build step and no local database - every file it reads (data/*.json,
# including the vendored data/world-110m.json - see docs/javascript.md's
# "Vendoring a third-party data file") is committed on purpose, and
# node_modules/ is already covered by the blanket rule above.
